@page "/budget"
@rendermode InteractiveServer
@inject BudgetState State
@implements IDisposable

<PageTitle>Budget</PageTitle>

<h3 class="mb-4">Monthly budget</h3>

<div class="card mb-4">
    <div class="card-body">
        <label class="form-label">Monthly limit</label>
        <div class="input-group mb-3">
            <input type="number" class="form-control" min="0" max="10000000" @bind="limit" />
            <button class="btn btn-primary" @onclick="Save">Save</button>
        </div>
        @if (saved)
        {
            <div class="text-success">Saved</div>
        }
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h5 class="mb-3">This month</h5>
        <BudgetBar Spent="State.Spent" Limit="State.Limit" />
    </div>
</div>

@code {
    private decimal limit;
    private bool saved;

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += Update;
        await State.RefreshAsync();
        limit = State.Limit;
    }

    private async Task Save()
    {
        await State.SetLimitAsync(limit);
        saved = true;
    }

    private void Update() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.OnChange -= Update;
}