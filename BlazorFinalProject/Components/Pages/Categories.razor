@page "/categories"
@rendermode InteractiveServer
@inject ICategoryService CategoryService

<PageTitle>Categories</PageTitle>

<h3 class="mb-4">Categories</h3>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}

<div class="card mb-4">
    <div class="card-body pb-0">
        <CategoryForm OnAdded="Add" />
    </div>
</div>

<ul class="list-group">
    @foreach (var c in categories)
    {
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <span>
                <span class="badge me-2" style="background-color:@c.Color">&nbsp;</span>
                @c.Name
            </span>
            <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(c.Id)">Delete</button>
        </li>
    }
</ul>

@code {
    private List<Category> categories = new();
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        categories = await CategoryService.GetAllAsync();
    }

    private async Task Add(Category category)
    {
        error = null;
        try
        {
            await CategoryService.AddAsync(category);
            categories = await CategoryService.GetAllAsync();
        }
        catch (Exception)
        {
            error = "Could not add the category.";
        }
    }

    private async Task Delete(int id)
    {
        error = null;
        try
        {
            await CategoryService.DeleteAsync(id);
            categories = await CategoryService.GetAllAsync();
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
    }
}