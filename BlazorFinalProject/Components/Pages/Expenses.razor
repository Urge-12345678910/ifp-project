@page "/expenses"
@rendermode InteractiveServer
@inject IExpenseService ExpenseService
@inject ICategoryService CategoryService
@inject BudgetState State

<PageTitle>Expenses</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Expenses</h3>
    <a class="btn btn-primary" href="expenses/add">Add</a>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-6">
        <input class="form-control" placeholder="Search by title"
               @bind="search" @bind:event="oninput" @bind:after="Load" />
    </div>
    <div class="col-md-6">
        <select class="form-select" @bind="categoryId" @bind:after="Load">
            <option value="">All categories</option>
            @foreach (var c in categories)
            {
                <option value="@c.Id">@c.Name</option>
            }
        </select>
    </div>
</div>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}

@if (idToDelete is not null)
{
    <div class="alert alert-warning d-flex justify-content-between align-items-center">
        <span>Delete this expense?</span>
        <span>
            <button class="btn btn-sm btn-danger me-2" @onclick="ConfirmDelete">Yes</button>
            <button class="btn btn-sm btn-secondary" @onclick="() => idToDelete = null">No</button>
        </span>
    </div>
}

@if (items is null)
{
    <p>Loading...</p>
}
else if (items.Count == 0)
{
    <p class="text-muted">No expenses yet.</p>
}
else
{
    <div class="card">
        <div class="card-body">
            <DataTable Items="items">
                <Header>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Amount</th>
                    <th>Date</th>
                    <th></th>
                </Header>
                <Row Context="e">
                    <td>@e.Title</td>
                    <td>@e.Category?.Name</td>
                    <td>@e.Amount.ToString("N2")</td>
                    <td>@e.Date.ToShortDateString()</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" href="expenses/edit/@e.Id">Edit</a>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => idToDelete = e.Id">Delete</button>
                    </td>
                </Row>
            </DataTable>
        </div>
    </div>
}

@code {
    private List<Expense>? items;
    private List<Category> categories = new();
    private string? search;
    private int? categoryId;
    private string? error;
    private int? idToDelete;

    protected override async Task OnInitializedAsync()
    {
        categories = await CategoryService.GetAllAsync();
        await Load();
    }

    private async Task Load()
    {
        items = await ExpenseService.GetAllAsync(categoryId, search);
    }

    private async Task ConfirmDelete()
    {
        error = null;
        try
        {
            await ExpenseService.DeleteAsync(idToDelete!.Value);
            await State.RefreshAsync();
            await Load();
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
        idToDelete = null;
    }
}