@if (Limit > 0)
{
    <div class="d-flex justify-content-between mb-1">
        <span>@Spent.ToString("N2") of @Limit.ToString("N2")</span>
        <span>@Percent%</span>
    </div>
    <div class="progress" style="height:12px">
        <div class="@("progress-bar bg-" + Color)" style="width:@(Math.Min(Percent, 100))%"></div>
    </div>

    @if (Spent > Limit)
    {
        <div class="alert alert-danger mt-3 mb-0">
            Budget exceeded by @((Spent - Limit).ToString("N2"))
        </div>
    }
    else if (Percent >= 80)
    {
        <div class="alert alert-warning mt-3 mb-0">
            You have used @Percent% of your budget
        </div>
    }
}
else
{
    <p class="text-muted mb-0">No limit set.</p>
}

@code {
    [Parameter] public decimal Spent { get; set; }
    [Parameter] public decimal Limit { get; set; }

    private int Percent => Limit == 0 ? 0 : (int)(Spent / Limit * 100);
    private string Color => Percent >= 100 ? "danger" : Percent >= 80 ? "warning" : "success";
}